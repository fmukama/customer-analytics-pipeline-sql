# Copy to .env before running `make up`:  make env
# Every variable here also has a fallback default in docker-compose.yml and the
# Makefile, so the stack still starts if .env is absent.

# PostgreSQL Connection Configuration
POSTGRES_HOST=localhost
# Host-side port only. Deliberately NOT 5432: a locally installed PostgreSQL
# service (13 / 16 / 17 ...) commonly already owns 5432-5434, and on Windows it
# silently wins the connection, producing a confusing
# "password authentication failed" instead of a bind error.
# Inside Docker the server still listens on 5432, so nothing else changes.
POSTGRES_PORT=55432
POSTGRES_DB=ecom_inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Adminer web UI (http://localhost:<ADMINER_PORT>)
ADMINER_PORT=8080

# Seeding Parameters (src/seed.py)
SEED_CUSTOMERS_COUNT=50
SEED_PRODUCTS_COUNT=20
SEED_ORDERS_COUNT=100
# Fixed Faker seed keeps generated data reproducible across runs and in CI.
SEED_RANDOM_STATE=42
